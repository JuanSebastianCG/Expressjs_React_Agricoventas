{
  "AWSEBDockerrunVersion": "3",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/agricoventas-frontend:latest",
      "essential": true,
      "memory": 256,
      "portMappings": [
        {
          "hostPort": 80,
          "containerPort": 80
        }
      ],
      "links": ["backend"]
    },
    {
      "name": "backend",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/agricoventas-backend:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "hostPort": 3000,
          "containerPort": 3000
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "DATABASE_URL",
          "value": "mongodb://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:27017/agricoventas"
        },
        {
          "name": "AWS_REGION",
          "value": "${AWS_REGION}"
        },
        {
          "name": "AWS_S3_BUCKET",
          "value": "${AWS_S3_BUCKET}"
        }
      ],
      "links": ["mongodb"]
    },
    {
      "name": "mongodb",
      "image": "mongo:7.0",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "hostPort": 27017,
          "containerPort": 27017
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "mongodb-data",
          "containerPath": "/data/db",
          "readOnly": false
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "mongodb-data",
      "host": {
        "sourcePath": "/var/app/mongodb-data"
      }
    }
  ]
} 