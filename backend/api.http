###############################################################
# Agricoventas API - HTTP Client Requests
###############################################################

@baseUrl = http://localhost:4000
@apiUrl = {{baseUrl}}/api
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleGFtcGxlIjoidG9rZW4ifQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c

###############################################################
# 1. Autenticación (Auth)
###############################################################

### 1.1 Registrar un nuevo usuario
POST {{apiUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Juan Pérez",
  "username": "juanperez",
  "email": "juan@example.com",
  "password": "Password123!",
  "city": "Medellín",
  "state": "Antioquia"
}

### 1.2 Iniciar sesión
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "juanperez",
  "password": "Password123!"
}

### 1.3 Cerrar sesión
POST {{apiUrl}}/auth/logout
Authorization: Bearer {{token}}

### 1.4 Refrescar tokens
POST {{apiUrl}}/auth/refresh

### 1.5 Obtener perfil del usuario actual
GET {{apiUrl}}/auth/profile
Authorization: Bearer {{token}}

###############################################################
# 2. Usuarios (Users)
###############################################################

### 2.1 Obtener todos los usuarios (admin)
GET {{apiUrl}}/users
Authorization: Bearer {{token}}

### 2.2 Obtener mi perfil
GET {{apiUrl}}/users/me
Authorization: Bearer {{token}}

### 2.3 Actualizar mi perfil
PUT {{apiUrl}}/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Juan Pérez Actualizado",
  "email": "juan_updated@example.com",
  "password": "NewPassword123!"
}

### 2.4 Actualizar mi imagen de perfil
PUT {{apiUrl}}/users/me/profile-image
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "imageUrl": "https://ejemplo.com/imagen.jpg"
}

### 2.5 Obtener usuario por ID
GET {{apiUrl}}/users/123456789
Authorization: Bearer {{token}}

### 2.6 Actualizar usuario (admin)
PUT {{apiUrl}}/users/123456789
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Juan Pérez Admin",
  "email": "juan_admin@example.com",
  "role": "user",
  "isActive": true
}

### 2.7 Actualizar imagen de perfil de un usuario
PUT {{apiUrl}}/users/123456789/profile-image
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "imageUrl": "https://ejemplo.com/imagen_admin.jpg"
}

### 2.8 Eliminar usuario
DELETE {{apiUrl}}/users/123456789
Authorization: Bearer {{token}}

###############################################################
# 3. Ubicaciones (Locations)
###############################################################

### 3.1 Crear una nueva ubicación
POST {{apiUrl}}/locations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Finca Los Alpes",
  "address": "Km 5 Vía al Mar",
  "city": "Medellín",
  "state": "Antioquia",
  "country": "Colombia",
  "postalCode": "050001",
  "description": "Finca productora de café en las montañas de Antioquia"
}

### 3.2 Obtener todas las ubicaciones
GET {{apiUrl}}/locations
Authorization: Bearer {{token}}

### 3.3 Buscar ubicaciones
GET {{apiUrl}}/locations/search?query=Medellín
Authorization: Bearer {{token}}

### 3.4 Obtener ubicación por ID
GET {{apiUrl}}/locations/123456789
Authorization: Bearer {{token}}

### 3.5 Actualizar ubicación
PUT {{apiUrl}}/locations/123456789
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Finca Los Alpes Actualizada",
  "address": "Km 5.5 Vía al Mar",
  "city": "Medellín",
  "state": "Antioquia",
  "description": "Finca actualizada"
}

### 3.6 Eliminar ubicación
DELETE {{apiUrl}}/locations/123456789
Authorization: Bearer {{token}}

### 3.7 Obtener ubicaciones de un usuario
GET {{apiUrl}}/locations/users/123456789
Authorization: Bearer {{token}}

### 3.8 Asignar ubicación a un usuario
POST {{apiUrl}}/locations/users/123456789
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "locationId": "987654321",
  "isPrimary": true
}

### 3.9 Eliminar ubicación de un usuario
DELETE {{apiUrl}}/locations/users/123456789/987654321
Authorization: Bearer {{token}}

### 3.10 Obtener ubicaciones de un producto
GET {{apiUrl}}/locations/products/123456789
Authorization: Bearer {{token}}

### 3.11 Asignar ubicación a un producto
POST {{apiUrl}}/locations/products/123456789
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "locationId": "987654321",
  "isPrimary": true
}

### 3.12 Eliminar ubicación de un producto
DELETE {{apiUrl}}/locations/products/123456789/987654321
Authorization: Bearer {{token}}

###############################################################
# 4. Productos (Products)
###############################################################

### 4.1 Crear un nuevo producto
POST {{apiUrl}}/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Café Especial",
  "description": "Café de origen único cultivado a 1800msnm",
  "price": 25000,
  "unit": "kg",
  "stockQuantity": 100,
  "categoryId": "123456789",
  "images": ["https://ejemplo.com/cafe1.jpg", "https://ejemplo.com/cafe2.jpg"],
  "availabilityDate": "2023-06-01T00:00:00Z",
  "specifications": {
    "variety": "Caturra",
    "altitude": "1800msnm",
    "process": "Lavado"
  }
}

### 4.2 Obtener producto por ID
GET {{apiUrl}}/products/123456789

### 4.3 Obtener productos con filtros
GET {{apiUrl}}/products?category=123456789&search=café&min_price=20000&max_price=30000&page=1&limit=10

### 4.4 Actualizar producto
PUT {{apiUrl}}/products/123456789
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Café Premium",
  "price": 28000,
  "stockQuantity": 80
}

### 4.5 Eliminar producto
DELETE {{apiUrl}}/products/123456789
Authorization: Bearer {{token}}

###############################################################
# 5. Pedidos (Orders)
###############################################################

### 5.1 Crear un nuevo pedido
POST {{apiUrl}}/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "items": [
    {
      "productId": "123456789",
      "quantity": 2
    },
    {
      "productId": "987654321",
      "quantity": 1
    }
  ],
  "shippingAddress": {
    "fullName": "Juan Pérez",
    "line1": "Calle 10 # 20-30",
    "city": "Medellín",
    "state": "Antioquia",
    "postalCode": "050001",
    "country": "Colombia",
    "phoneNumber": "3001234567"
  },
  "paymentMethod": "BANK_TRANSFER",
  "notes": "Entregar en la mañana"
}

### 5.2 Obtener pedido por ID
GET {{apiUrl}}/orders/123456789
Authorization: Bearer {{token}}

### 5.3 Obtener pedido por número de pedido
GET {{apiUrl}}/orders/number/ORD-2023-0001
Authorization: Bearer {{token}}

### 5.4 Obtener pedidos con filtros
GET {{apiUrl}}/orders?status=PENDING&fromDate=2023-01-01T00:00:00Z&toDate=2023-12-31T23:59:59Z&page=1&limit=10
Authorization: Bearer {{token}}

### 5.5 Actualizar estado de pedido
PUT {{apiUrl}}/orders/123456789/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "PROCESSING"
}

### 5.6 Cancelar pedido
PUT {{apiUrl}}/orders/123456789/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Cliente solicitó cancelación"
}

### 5.7 Marcar pedido como pagado
PUT {{apiUrl}}/orders/123456789/mark-paid
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "paymentDetails": {
    "method": "BANK_TRANSFER",
    "transactionId": "TX123456789",
    "amount": 56000
  }
}

### 5.8 Actualizar información de envío
PUT {{apiUrl}}/orders/123456789/shipping
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "trackingNumber": "TR123456789",
  "carrier": "Servientrega",
  "estimatedDeliveryDate": "2023-06-15T00:00:00Z"
}

###############################################################
# 6. Categorías (Categories)
###############################################################

### 6.1 Crear una nueva categoría
POST {{apiUrl}}/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Frutas",
  "slug": "frutas",
  "description": "Frutas frescas de temporada"
}

### 6.2 Obtener categoría por ID
GET {{apiUrl}}/categories/123456789

### 6.3 Obtener categoría por slug
GET {{apiUrl}}/categories/slug/frutas

### 6.4 Obtener categorías con filtros
GET {{apiUrl}}/categories?search=frut&isActive=true&page=1&limit=10

### 6.5 Obtener árbol de categorías
GET {{apiUrl}}/categories/tree

### 6.6 Obtener categorías hijas
GET {{apiUrl}}/categories/123456789/children

### 6.7 Actualizar categoría
PUT {{apiUrl}}/categories/123456789
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Frutas Tropicales",
  "description": "Frutas tropicales de Colombia"
}

### 6.8 Eliminar categoría
DELETE {{apiUrl}}/categories/123456789
Authorization: Bearer {{token}} 