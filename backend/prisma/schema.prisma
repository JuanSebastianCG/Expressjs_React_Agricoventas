generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName  String
  username  String   @unique
  password  String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
